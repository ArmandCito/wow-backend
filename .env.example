# Copy to .env for local development. On Render, set the same names in the dashboard (Environment).
# Only SECRET_KEY and DATABASE_URL are required in production; everything else has a safe default.

# ───────── Django ─────────
SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com
# Public URL of the API, for the Django admin login form (https://<service>.onrender.com)
CSRF_TRUSTED_ORIGINS=

# ───────── Database ─────────
# Neon (production): the pooled connection string, with ?sslmode=require
DATABASE_URL=
# Or a local PostgreSQL (used when DATABASE_URL is empty)
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Both empty = SQLite file db.sqlite3 (quick start, tests)

# ───────── Website ─────────
# Public URL of the website: links in emails (password reset, staff invitations)
# Production: https://wow-quick-bites-ui.vercel.app
FRONTEND_URL=http://localhost:3000
# Long random secret shared with the website server only (Google sign-in, visitor IP for rate limits)
FRONTEND_SHARED_SECRET=
# Browser tools only (the website calls the API from its server): comma separated origins
CORS_ALLOWED_ORIGINS=

# ───────── Email (Brevo) ─────────
# Empty = emails are printed in the server log (development)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
EMAIL_SENDER_NAME=WOW Quick Bites

# ───────── Optional services ─────────
# Images uploaded from the portal. Recommended on Render (its disk is wiped on every deploy).
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Translates the language an editor left empty (otherwise the text is copied)
DEEPL_AUTH_KEY=

# ───────── First owner account (created at deploy if missing) ─────────
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# ───────── Tuning (defaults are fine) ─────────
# ACCESS_TOKEN_MINUTES=60
# REFRESH_TOKEN_DAYS=7
# NUM_PROXIES=1
